# Caddy: TLS (Let's Encrypt) and gzip. Hostnames are substituted by setup-server.sh.
# reverse_proxy appends the visitor's address to X-Forwarded-For; nginx's realip module reads it back.

__INDEXER_HOST__ {
    encode gzip
    reverse_proxy 127.0.0.1:8080
}

__PREVIEW_HOST__ {
    encode gzip
    root * /var/www/preview
    file_server
    try_files {path} {path}/ {path}.html
}

# The project domain serves the same static build (the ENS name on eth.limo stays the IPFS copy).
trenchampionship.com {
    encode gzip
    # Plain-number supply files for price trackers, written by ops/supply-api.sh from cron.
    handle_path /api/* {
        root * /var/www/api
        header Content-Type "text/plain; charset=utf-8"
        header Access-Control-Allow-Origin *
        header Cache-Control "public, max-age=120"
        file_server
    }
    root * /var/www/preview
    file_server
    try_files {path} {path}/ {path}.html
}

www.trenchampionship.com {
    redir https://trenchampionship.com{uri} permanent
}
