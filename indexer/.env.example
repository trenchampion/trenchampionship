# Which deployment to index: a file under ../contracts/deployments/<CHAIN_ID>.json must exist.
CHAIN_ID=31337

# RPC per chain id (Ponder convention). Free tiers are enough: public Base RPC, Alchemy, QuickNode.
PONDER_RPC_URL_31337=http://127.0.0.1:8545
PONDER_RPC_URL_84532=https://sepolia.base.org
PONDER_RPC_URL_8453=https://mainnet.base.org

# Block the contracts were deployed at (speeds up the initial sync; 0 for anvil).
START_BLOCK=0

# Optional: Postgres for production; SQLite (default) is fine for a single machine.
# DATABASE_URL=postgres://user:pass@localhost:5432/traitleague
