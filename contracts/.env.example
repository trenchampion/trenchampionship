# Copy this file to contracts/.env (gitignored) and fill in the values.
# forge loads contracts/.env automatically when run from this directory.
# Never paste the private key into chat, commits or logs.

# Deployer private key. The deployer is also the founder and receives the founder TL.
# Leave this line commented out for a hardware wallet (mainnet): then run the script with
# `--ledger --sender <deployer address>` and the device signs every transaction.
DEPLOYER_KEY=0x

# Address that receives the treasury shares fixed in Config.sol (mint, trade, rake).
TREASURY=0x

# Address allowed to call pause() for 365 days after deploy: a Safe, or the deployer.
GUARDIAN=0x

# Wei sent with the LaunchPool deploy for the founder buy. 20 % of the supply at V = 1 ETH is 2/7 ETH
# = 285714285714285714 wei (0.2857 ETH). Testnet suggestion: 5000000000000000 (0.005 ETH). 0 disables the founder buy.
FOUNDER_BUY_ETH=285714285714285714

# Optional. Etherscan V2 key for Basescan verification; Blockscout verification needs no key.
# ETHERSCAN_API_KEY=

# Optional. Private RPC (Alchemy, QuickNode free tier) instead of the public endpoint.
# RPC_URL=https://sepolia.base.org
