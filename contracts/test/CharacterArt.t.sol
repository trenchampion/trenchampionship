pragma solidity 0.8.26;

import {Test} from "forge-std/Test.sol";
import {stdJson} from "forge-std/StdJson.sol";
import {BattleEngine} from "../src/BattleEngine.sol";
import {CharacterArt} from "../src/CharacterArt.sol";
import {CharacterPortrait} from "../src/CharacterPortrait.sol";
import {deployPortrait} from "./helpers/ArtDeploy.sol";

/// @dev Exposes the internal metadata library for tests, on top of the deployed portrait.
contract ArtHarness {
    CharacterPortrait public immutable PORTRAIT;

    constructor(CharacterPortrait portrait) {
        PORTRAIT = portrait;
    }

    function svg(uint256 id, BattleEngine.Traits memory t) external view returns (string memory) {
        return PORTRAIT.svg(id, t);
    }

    function uri(uint256 id, BattleEngine.Traits memory t, string memory name) external view returns (string memory) {
        return CharacterArt.tokenURI(id, t, name, PORTRAIT.svg(id, t), PORTRAIT.attributes(id, t));
    }

    function elementName(uint8 e) external pure returns (string memory) {
        return CharacterArt.elementName(e);
    }

    function specialName(uint8 s) external pure returns (string memory) {
        return CharacterArt.specialName(s);
    }
}

contract CharacterArtTest is Test {
    using stdJson for string;

    CharacterPortrait internal portrait;
    ArtHarness internal h;

    function setUp() public {
        portrait = deployPortrait();
        h = new ArtHarness(portrait);
    }

    function _traits(uint256[] memory v) internal pure returns (BattleEngine.Traits memory t) {
        t.strength = uint8(v[0]);
        t.defense = uint8(v[1]);
        t.speed = uint8(v[2]);
        t.focus = uint8(v[3]);
        t.element = uint8(v[4]);
        t.special = uint8(v[5]);
        t.weakness = uint8(v[6]);
    }

    function _startsWith(string memory s, string memory prefix) internal pure returns (bool) {
        bytes memory a = bytes(s);
        bytes memory p = bytes(prefix);
        if (a.length < p.length) return false;
        for (uint256 i; i < p.length; i++) {
            if (a[i] != p[i]) return false;
        }
        return true;
    }

    /// @notice Every shared vector (generated by engine/scripts/gen-art-vectors.mjs) matches byte for byte.
    function test_sharedVectors() public view {
        string memory doc = vm.readFile("../engine/vectors/art-vectors.json");
        uint256 count = doc.readUint(".count");
        assertGe(count, 96, "vector count");
        for (uint256 i; i < count; i++) {
            string memory p = string.concat(".cases[", vm.toString(i), "]");
            uint256 id = vm.parseUint(doc.readString(string.concat(p, ".id")));
            BattleEngine.Traits memory t = _traits(doc.readUintArray(string.concat(p, ".traits")));
            string memory name = doc.readString(string.concat(p, ".name"));
            bytes32 svgHash = doc.readBytes32(string.concat(p, ".svgKeccak"));
            bytes32 uriHash = doc.readBytes32(string.concat(p, ".uriKeccak"));
            assertEq(keccak256(bytes(h.svg(id, t))), svgHash, string.concat("svg case ", vm.toString(i)));
            assertEq(keccak256(bytes(h.uri(id, t, name))), uriHash, string.concat("uri case ", vm.toString(i)));
        }
    }

    function test_structure() public view {
        uint256[] memory v = new uint256[](7);
        v[0] = 15;
        v[1] = 1;
        v[2] = 14;
        v[3] = 15;
        v[4] = 0;
        v[5] = 1;
        v[6] = 2;
        BattleEngine.Traits memory t = _traits(v);
        string memory s = h.svg(1, t);
        assertTrue(_startsWith(s, '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">'), "svg prefix");
        assertTrue(_startsWith(h.uri(1, t, "Hero"), "data:application/json;base64,"), "uri prefix");
        assertTrue(_startsWith(portrait.attributes(1, t), ',{"trait_type":"Skin","value":"'), "attributes prefix");
        // determinism
        assertEq(keccak256(bytes(h.svg(1, t))), keccak256(bytes(h.svg(1, t))));
        // the id changes the variants, the name changes the metadata, the traits change the image
        assertTrue(keccak256(bytes(h.svg(2, t))) != keccak256(bytes(s)), "id matters");
        assertTrue(keccak256(bytes(h.uri(1, t, "Other"))) != keccak256(bytes(h.uri(1, t, "Hero"))), "name matters");
        t.element = 3;
        assertTrue(keccak256(bytes(h.svg(1, t))) != keccak256(bytes(s)), "traits matter");
    }

    function test_names() public view {
        assertEq(h.elementName(0), "Fire");
        assertEq(h.elementName(4), "Shadow");
        assertEq(h.elementName(9), "Shadow");
        assertEq(h.specialName(0), "None");
        assertEq(h.specialName(7), "Counterstrike");
        assertEq(h.specialName(99), "None");
    }

    function test_zeroAddressParts() public {
        address[5] memory parts = [
            address(portrait.BASE()),
            address(portrait.BODY()),
            address(portrait.FACE()),
            address(portrait.ITEMS()),
            address(portrait.ARMS())
        ];
        for (uint256 k; k < 5; k++) {
            address[5] memory broken = parts;
            broken[k] = address(0);
            vm.expectRevert(CharacterPortrait.ZeroAddress.selector);
            new CharacterPortrait(broken);
        }
        CharacterPortrait ok = new CharacterPortrait(parts);
        assertEq(address(ok.BODY()), parts[1]);
    }
}
